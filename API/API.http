@API_HostAddress = http://localhost:5161

# ===== משתמשים =====

# כל המשתמשים
GET {{API_HostAddress}}/api/users
Accept: application/json

###

# משתמש לפי מזהה
GET {{API_HostAddress}}/api/users/1
Accept: application/json

###

# האם שם משתמש קיים
GET {{API_HostAddress}}/api/users/exists/dana_c

###

# האם אימייל קיים
GET {{API_HostAddress}}/api/users/email-exists/dana@example.com

###

# ספירת משתמשים לפי תפקיד
GET {{API_HostAddress}}/api/users/count-by-role

###

# הוספת משתמש בדיקה
POST {{API_HostAddress}}/api/users
Content-Type: application/json

{
  "username": "test_user",
  "email": "test.user@example.com",
  "passwordHash": "Test123!"
}

###

# התחברות עם פרטים נכונים
POST {{API_HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "admin1",
  "passwordHash": "AdminPass123!"
}

###

# התחברות עם סיסמה שגויה (מחזיר 401)
POST {{API_HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "admin1",
  "passwordHash": "wrong"
}
